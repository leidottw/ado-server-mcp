{
  "name": "@cb/ado-server-mcp",
  "description": "MCP Server for Azure DevOps Server (On-Premise) supporting work item management, pull requests, and project operations",
  "version": "0.11.0",
  "type": "module",
  "bin": {
    "ado-server-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "bun build.ts",
    "start": "bun run ./src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "bun run build && simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.ts": ["prettier --write", "eslint --fix"]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.5.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "azure-devops-node-api": "^15.1.2",
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
