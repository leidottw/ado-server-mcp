# Azure DevOps Server (On-Premise) 連線設定
# 這個範例檔案可用於手動建立 .env，特別是在
# 1) 使用 .vscode/launch.json 進行偵錯
# 2) 或直接從 terminal 執行 src/index.ts 時
#
# 若需要，請依據此格式建立 .env。
AZURE_DEVOPS_URL=http://my-local-server:8080/tfs/DefaultCollection
AZURE_DEVOPS_TOKEN=your-personal-access-token

# 如果使用自簽章 HTTPS，可以啟用以下選項
# NODE_TLS_REJECT_UNAUTHORIZED=0
