# 若需要，請依據此格式建立 .env。
AZURE_DEVOPS_URL=http://my-local-server:8080/tfs/DefaultCollection
AZURE_DEVOPS_TOKEN=your-personal-access-token

# 如果使用自簽章 HTTPS，請取消註解以下行以允許不受信任的憑證（注意：這會降低安全性，僅在測試環境中使用）。
# NODE_TLS_REJECT_UNAUTHORIZED=0

# File Handoff 設定（大型內容自動寫入暫存檔）
# ADO_MCP_OUTPUT_DIR=/tmp/ado-mcp          # 暫存目錄，預設 $TMPDIR/ado-mcp
# ADO_MCP_INLINE_LIMIT=10000               # 超過此字元數才寫檔，預設 10000
# ADO_MCP_FILE_HANDOFF=off                 # 設為 off 可完全停用，預設 on
